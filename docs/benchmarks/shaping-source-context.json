    "finding": "Contextual clusters are absolute and require range-relative normalization before fpdf2 subset mapping; repeated substrings require source positions, not string.find",
    "source": "import json\nfrom pathlib import Path\nimport uharfbuzz as hb\nfont_path='/System/Library/Fonts/Supplemental/Arial.ttf'\nfont=hb.Font(hb.Face(Path(font_path).read_bytes()))\ncases={}\nfor word,splits in [('سلام',[1,2,3]),('عالمسلام',[4]),('سسسس',[1,2,3])]:\n output=[]\n for cut in splits:\n  fragments=[]\n  for start,end in [(0,cut),(cut,len(word))]:\n   local=hb.Buffer();local.add_str(word[start:end]);local.guess_segment_properties();hb.shape(font,local)\n   contextual=hb.Buffer();contextual.add_str(word,start,end-start);contextual.guess_segment_properties();hb.shape(font,contextual)\n   fragments.append({'range':[start,end],'isolated':[(i.codepoint,i.cluster,p.x_advance) for i,p in zip(local.glyph_infos,local.glyph_positions)],'contextual':[(i.codepoint,i.cluster-start,p.x_advance) for i,p in zip(contextual.glyph_infos,contextual.glyph_positions)]})\n  output.append({'cut':cut,'fragments':fragments})\n cases[word]=output\nresult={'font':font_path,'font_sha256':__import__('hashlib').sha256(Path(font_path).read_bytes()).hexdigest(),'cases':cases,'finding':'Contextual clusters are absolute and require range-relative normalization before fpdf2 subset mapping; repeated substrings require source positions, not string.find','source':Path(__file__).read_text()}\nPath('/tmp/docweave-context-design-probe.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps(cases,ensure_ascii=False))\n"
  },
