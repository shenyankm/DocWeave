  "fixture_probe": "from pathlib import Path\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\nimport aspose.words_foss as aw\nroot=Path('/tmp/docweave-table-position');root.mkdir(exist_ok=True)\nfor mode in (12,14,15):\n for align in (0,1,2):\n  for indent in (0,24):\n   d=Document();s=d.sections[0]\n   s.page_width=s.page_height=Pt(300)\n   s.left_margin=s.right_margin=s.top_margin=s.bottom_margin=Pt(20)\n   d.add_paragraph('BODY').runs[0].font.size=Pt(12)\n   t=d.add_table(rows=1,cols=1);t.autofit=False;t.style='Table Grid'\n   t.columns[0].width=Pt(160);t.cell(0,0).width=Pt(160);t.alignment=WD_TABLE_ALIGNMENT(align)\n   pr=t._tbl.tblPr\n   width=pr.find(qn('w:tblW'));width.set(qn('w:w'),'3200');width.set(qn('w:type'),'dxa')\n   e=OxmlElement('w:tblInd');e.set(qn('w:w'),str(indent*20));e.set(qn('w:type'),'dxa');pr.append(e)\n   c=t.cell(0,0);m=OxmlElement('w:tcMar')\n   for name in ('left','right'):\n    e=OxmlElement('w:'+name);e.set(qn('w:w'),'160');e.set(qn('w:type'),'dxa');m.append(e)\n   c._tc.get_or_add_tcPr().append(m);r=c.paragraphs[0].add_run('CELL');r.font.name='Arial';r.font.size=Pt(12)\n   compat=d.settings.element.find(qn('w:compat'))\n   setting=next(e for e in compat if e.get(qn('w:name'))=='compatibilityMode')\n   setting.set(qn('w:val'),str(mode))\n   source=root/f'm{mode}-a{align}-i{indent}.docx';d.save(source)\n   aw.Document(source).save(root/f'm{mode}-a{align}-i{indent}-before.pdf')\nprint(root)\n",
  "comparison_probe": "import json,pymupdf\nfrom pathlib import Path\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__, aw.__file__\nroot=Path('/tmp/docweave-table-position')\ndata=json.loads(Path('/tmp/docweave-table-position-before.json').read_text())\nfor source in sorted(root.glob('*.docx')):\n document=aw.Document(source)\n target=source.with_name(source.stem+'-after.pdf');document.save(target)\n with pymupdf.open(target) as pdf:\n  words=pdf[0].get_text('words');cell=next(w for w in words if w[4]=='CELL')\n  data[source.stem]['after']={'mode':document.light_document_model.compatibility_mode,\n   'cell_x_pt':cell[0],'words':[w[4] for w in words],'pages':len(pdf)}\n  assert data[source.stem]['after']['words']==data[source.stem]['native']['words']\n  assert data[source.stem]['after']['pages']==data[source.stem]['native']['pages']==1\n for kind in ('native','after'):\n  if source.stem in ('m14-a0-i24','m15-a0-i0','m14-a1-i24'):\n   path=source.with_suffix('.pdf') if kind=='native' else target\n   with pymupdf.open(path) as pdf:pdf[0].get_pixmap(matrix=pymupdf.Matrix(2,2)).save(root/(source.stem+'-'+kind+'.png'))\nresult={'cases':data,'maximum_origin_error_before_pt':max(abs(v['before']['cell_x_pt']-v['native']['cell_x_pt']) for v in data.values()),\n 'maximum_origin_error_after_pt':max(abs(v['after']['cell_x_pt']-v['native']['cell_x_pt']) for v in data.values())}\nPath('/tmp/docweave-table-position-comparison.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint('maximum origin error pt:',result['maximum_origin_error_before_pt'],result['maximum_origin_error_after_pt'])\n",
  "corpus_probe": "import json,hashlib,sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__, aw.__file__\nraw=aw.Document('/tmp/docweave-current-performance/image_table.docx').to_bytes(aw.saving.PdfSaveOptions())\nresult={'bytes':len(raw),'pages':[]}\nwith pymupdf.open(stream=raw,filetype='pdf') as pdf:\n for page in pdf:\n  images=[]\n  for info in page.get_image_info(hashes=True):\n   images.append({'bbox':list(info['bbox']),'digest':info['digest'].hex()})\n  result['pages'].append({'words':[list(word) for word in page.get_text('words')], 'images':images})\n pdf[0].get_pixmap(matrix=pymupdf.Matrix(2,2)).save('/tmp/docweave-table-corpus-'+sys.argv[1]+'.png')\nPath('/tmp/docweave-table-corpus-'+sys.argv[1]+'.json').write_text(json.dumps(result,indent=2)+'\\n')\nPath('/tmp/docweave-table-corpus-'+sys.argv[1]+'.pdf').write_bytes(raw)\nprint('saved',sys.argv[1])\n",
