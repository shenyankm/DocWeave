  "probe_source": "import hashlib, json, runpy, sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__\nns = runpy.run_path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python/tests/test_pdf_center_alignment.py')\nresults = {}\nfor kind in ('plain', 'list'):\n for columns in (1, 2):\n  for shaping in (False, True):\n   for count in (1, 3):\n    model = ns['center_model'](kind, columns, count)\n    options = aw.saving.PdfSaveOptions(); options.text_shaping = shaping\n    raw = ns['LdmPdfWriter'](options).write_to_bytes(model)\n    key = f'{kind}-{columns}-{shaping}-{count}'\n    expected = (20+24+20+(260-15*(columns-1))/columns-6)/2\n    with pymupdf.open(stream=raw, filetype='pdf') as pdf:\n     centers=[]\n     for page in pdf:\n      for block in page.get_text('rawdict')['blocks']:\n       for line in block.get('lines', []):\n        chars=[c for s in line['spans'] for c in s['chars'] if c['c'] in 'CENTER']\n        if chars:\n         assert ''.join(c['c'] for c in chars)=='CENTER'\n         centers.append((min(c['bbox'][0] for c in chars)+max(c['bbox'][2] for c in chars))/2)\n     assert len(centers)==count\n     results[key]={'expected_center_pt':expected,'actual_centers_pt':centers,'max_error_pt':max(abs(c-expected) for c in centers),'pages':len(pdf),'bytes':len(raw)}\n     if key=='list-2-True-3':\n      pdf.save('/tmp/docweave-center-'+sys.argv[1]+'.pdf')\n      page=pdf[0]; page.draw_line((expected,0),(expected,180),color=(1,0,0),width=.3)\n      page.get_pixmap(matrix=pymupdf.Matrix(3,3)).save('/tmp/docweave-center-'+sys.argv[1]+'.png')\nPath('/tmp/docweave-center-'+sys.argv[1]+'.json').write_text(json.dumps(results,indent=2)+'\\n')\nprint({'cases':len(results),'max_error_pt':max(r['max_error_pt'] for r in results.values())})\n",
