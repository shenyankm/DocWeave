    "probe_source": "import json,sys,time,resource,statistics\nfrom pathlib import Path\nimport aspose.words_foss as aw\nfrom aspose.words_foss import light_document_model as ldm\nfrom aspose.words_foss.pdf_writer import LdmPdfWriter\nassert Path(aw.__file__).is_relative_to(Path(sys.prefix)),(aw.__file__,sys.prefix)\nparagraphs=[]\nfor i in range(80):\n paragraphs.append(ldm.Paragraph(children=[ldm.Run(text='ONE TWO THREE FOUR FIVE SIX SEVEN EIGHT NINE TEN ',font=ldm.Font(size=12,color='FF0000' if i%2 else ''))],paragraph_format=ldm.ParagraphFormat(alignment=int(sys.argv[1]),style_name='Code')))\nmodel=ldm.Document(sections=[ldm.Section(page_setup=ldm.PageSetup(page_width=220,page_height=300,left_margin=20,right_margin=20,top_margin=20,bottom_margin=20),body=ldm.Body(children=paragraphs))])\nLdmPdfWriter().write_to_bytes(model)\ntimes=[]\nfor _ in range(3):\n start=time.perf_counter();raw=LdmPdfWriter().write_to_bytes(model);times.append(time.perf_counter()-start)\nprint(json.dumps({'alignment':int(sys.argv[1]),'seconds':times,'median_seconds':statistics.median(times),'bytes':len(raw),'peak_rss_bytes':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'python':sys.version.split()[0],'module':aw.__file__}))\n"
