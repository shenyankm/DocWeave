  "probe_source": "import json,runpy,sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__\nns=runpy.run_path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python/tests/test_pdf_split_line_alignment.py')\nresults={}\nfor location in ('body','header','footer'):\n for kind in ('toc','gap'):\n  for columns in (1,2):\n   for shaping in (False,True):\n    model=ns['split_line_model'](kind,columns,location)\n    options=aw.saving.PdfSaveOptions();options.text_shaping=shaping\n    raw=ns['LdmPdfWriter'](options).write_to_bytes(model)\n    width=(260-15*(columns-1))/columns if location=='body' else 260\n    expected=20+width-6-72/25.4\n    with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n     assert len(pdf)==1\n     words={w[4]:w for w in pdf[0].get_text('words')}\n     assert 'TITLE' in words and '123' in words\n     key=f'{location}-{kind}-{columns}-{shaping}'\n     results[key]={'expected_right_pt':expected,'actual_right_pt':words['123'][2],'error_pt':abs(words['123'][2]-expected),'words':words,'bytes':len(raw),'pages':len(pdf)}\n     if key=='footer-gap-2-True':\n      pdf.save('/tmp/docweave-split-line-'+sys.argv[1]+'.pdf')\n      pdf[0].draw_line((expected,0),(expected,180),color=(1,0,0),width=.3)\n      pdf[0].get_pixmap(matrix=pymupdf.Matrix(3,3)).save('/tmp/docweave-split-line-'+sys.argv[1]+'.png')\nPath('/tmp/docweave-split-line-'+sys.argv[1]+'.json').write_text(json.dumps(results,indent=2)+'\\n')\nprint({'cases':len(results),'max_error_pt':max(v['error_pt'] for v in results.values())})\n",
