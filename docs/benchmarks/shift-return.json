  "probes": {
    "docweave-shift-return-probe.py": "from io import BytesIO\nfrom pathlib import Path\nimport json,sys\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.style import WD_STYLE_TYPE\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nresults={}\nfor style in ['Normal','Code']:\n for value in [None,'on','off','0']:\n  doc=Document();doc.styles.add_style('Code',WD_STYLE_TYPE.PARAGRAPH)\n  sec=doc.sections[0];sec.page_width=Pt(220);sec.page_height=Pt(200)\n  sec.left_margin=sec.right_margin=sec.top_margin=sec.bottom_margin=Pt(20)\n  p=doc.add_paragraph(style=style);p.alignment=WD_ALIGN_PARAGRAPH.JUSTIFY\n  r=p.add_run('SHORT LINE\\nONE TWO THREE FOUR FIVE SIX SEVEN EIGHT NINE TEN');r.font.name='Arial';r.font.size=Pt(12)\n  if value:\n   flag=OxmlElement('w:doNotExpandShiftReturn');flag.set(qn('w:val'),value);doc.settings.element.find(qn('w:compat')).append(flag)\n  stream=BytesIO();doc.save(stream);source=stream.getvalue()\n  key=f'{style}-{value}'\n  if style=='Code' and value in (None,'on'):Path('/tmp/docweave-shift-return-'+str(value)+'.docx').write_bytes(source)\n  for shaping in [False,True]:\n   parsed=aw.Document(BytesIO(source));options=aw.saving.PdfSaveOptions();options.text_shaping=shaping\n   raw=parsed.to_bytes(options)\n   with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n    words=[w for page in pdf for w in page.get_text('words')]\n    end=next(w[2] for w in words if w[4]=='LINE')\n    results[f'{key}-{shaping}']={'flag':getattr(parsed.light_document_model,'do_not_expand_shift_return',None),'manual_right_pt':end,'words':[w[4] for w in words],'pages':len(pdf),'bytes':len(raw)}\n    if style=='Code' and value in (None,'on') and not shaping:\n     Path('/tmp/docweave-shift-return-'+str(value)+'-'+sys.argv[1]+'.pdf').write_bytes(raw)\n     pdf[0].get_pixmap(matrix=pymupdf.Matrix(3,3)).save('/tmp/docweave-shift-return-'+str(value)+'-'+sys.argv[1]+'.png')\nPath('/tmp/docweave-shift-return-'+sys.argv[1]+'.json').write_text(json.dumps(results,indent=2)+'\\n')\nprint({k:v['manual_right_pt'] for k,v in results.items()})\n",
    "docweave-shift-return-bands.py": "import json\nfrom pathlib import Path\nimport pymupdf\nfrom aspose.words_foss import light_document_model as ldm\nfrom aspose.words_foss.pdf_writer import LdmPdfWriter\nfrom aspose.words_foss.saving import PdfSaveOptions\nresult={}\nfor location in [0,1]:\n for disabled in [False,True]:\n  for shaping in [False,True]:\n   paragraph=ldm.Paragraph(children=[ldm.Run(text='SHORT LINE\\nLAST',font=ldm.Font(size=12))],paragraph_format=ldm.ParagraphFormat(alignment=3))\n   model=ldm.Document(do_not_expand_shift_return=disabled,sections=[ldm.Section(page_setup=ldm.PageSetup(page_width=220,page_height=260,left_margin=20,right_margin=20,top_margin=80,bottom_margin=80),body=ldm.Body(children=[ldm.Paragraph(children=[ldm.Run(text='BODY')])]),headers_footers=[ldm.HeaderFooter(header_footer_type=location,children=[paragraph])])])\n   options=PdfSaveOptions();options.text_shaping=shaping\n   with pymupdf.open(stream=LdmPdfWriter(options).write_to_bytes(model),filetype='pdf') as pdf:\n    words=[w for page in pdf for w in page.get_text('words')]\n    assert sorted(w[4] for w in words)==['BODY','LAST','LINE','SHORT']\n    end=next(w[2] for w in words if w[4]=='LINE')\n    assert end<120 if disabled else abs(end-(200-72/25.4))<0.05\n    result[f'{location}-{disabled}-{shaping}']={'manual_right_pt':end,'pages':len(pdf)}\nPath('/tmp/docweave-shift-return-bands.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(result)\n"
