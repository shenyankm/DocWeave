  "encoder": "import hashlib,json\nfrom pathlib import Path\nfrom io import BytesIO\nfrom fontTools.ttLib import TTFont,sfnt\nfrom fontTools.ttLib.sfnt import SFNTReader,SFNTWriter\nimport zopfli.zlib\nroot=Path('/tmp/docweave-font-glyph-names-baseline/aspose/words_foss/pdf_writer/fonts');out=Path('/tmp/docweave-post-fonts');out.mkdir(exist_ok=True);result={}\nfor face in ['Regular','Bold','Oblique','BoldOblique']:\n source=root/('DocumentSansSC-'+face+'.woff');target=out/source.name\n font=TTFont(source,recalcTimestamp=False);order=font.getGlyphOrder();post=font['post'];post.formatType=2.0;post.extraNames=[];post.mapping={};newpost=post.compile(font);font.close()\n with source.open('rb') as handle:\n  reader=SFNTReader(handle);cache={}\n  for tag,entry in reader.tables.items():\n   data=reader[tag]\n   if entry.length<entry.origLength:\n    handle.seek(entry.offset);cache[data]=handle.read(entry.length)\n  def compress(data,level=6):\n   return cache[data] if data in cache else zopfli.zlib.compress(data,numiterations=1)\n  sfnt.compress=compress\n  buffer=BytesIO();writer=SFNTWriter(buffer,len(reader.tables),reader.sfntVersion,flavor='woff',flavorData=reader.flavorData)\n  for tag in sorted(reader.keys(),key=lambda t:reader.tables[t].offset):writer[tag]=newpost if str(tag)=='post' else reader[tag]\n  writer.close();target.write_bytes(buffer.getvalue())\n with source.open('rb') as a,target.open('rb') as b:\n  old,new=SFNTReader(a),SFNTReader(b);changed=[str(t) for t in old.keys() if old[t]!=new[t]];assert changed==['head','post'],changed\n  assert old['head'][:8]+old['head'][12:]==new['head'][:8]+new['head'][12:]\n with TTFont(source) as a,TTFont(target) as b:\n  assert a.getGlyphOrder()==b.getGlyphOrder()==order\n  assert a.getBestCmap()==b.getBestCmap()\n  assert a['hmtx'].metrics==b['hmtx'].metrics\n result[face]={'before_bytes':source.stat().st_size,'after_bytes':target.stat().st_size,'delta_bytes':target.stat().st_size-source.stat().st_size,'changed_tables':changed,'glyphs':len(order),'sha256':hashlib.sha256(target.read_bytes()).hexdigest()}\n print(face,result[face],flush=True)\nPath('/tmp/docweave-post-font-candidates.json').write_text(json.dumps(result,indent=2)+'\\n')\n",
  "worker": "import time\nstart=time.perf_counter()\nimport sys,json,hashlib,resource\nfrom pathlib import Path\nfrom fpdf import FPDF\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nphase,case=sys.argv[1:3]\nif phase in ('baseline','candidate'):\n original=FPDF.add_font\n def add_font(pdf,family=None,style='',fname=None,**kwargs):\n  if fname and Path(fname).name.startswith('DocumentSansSC-'):\n   root=Path('/tmp/docweave-post-fonts') if phase=='candidate' else Path('/tmp/docweave-font-glyph-names-baseline/aspose/words_foss/pdf_writer/fonts')\n   fname=root/Path(fname).name\n  return original(pdf,family,style,fname,**kwargs)\n FPDF.add_font=add_font\nloaded=time.perf_counter()\nsource=Path('/tmp/docweave-row-height-units/small-rows.docx') if case=='small_rows' else Path('/tmp/docweave-current-performance')/(case+'.docx')\ndoc=aw.Document(source);parsed=time.perf_counter();raw=doc.to_bytes(aw.saving.PdfSaveOptions());finished=time.perf_counter()\nimport pymupdf\nwith pymupdf.open(stream=raw,filetype='pdf') as pdf:\n records=[{'words':hashlib.sha256(repr(p.get_text('words')).encode()).hexdigest(),'pixels':hashlib.sha256(p.get_pixmap().samples).hexdigest(),'drawings':hashlib.sha256(repr(p.get_drawings()).encode()).hexdigest(),'images':hashlib.sha256(repr(p.get_image_info()).encode()).hexdigest()} for p in pdf]\nrecord={'import_ms':1000*(loaded-start),'parse_ms':1000*(parsed-loaded),'render_ms':1000*(finished-parsed),'total_ms':1000*(finished-start),'peak_rss_bytes':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'bytes':len(raw),'pages':len(records),'records_sha256':hashlib.sha256(json.dumps(records,sort_keys=True,separators=(',',':')).encode()).hexdigest()}\nprint(json.dumps(record))\n",
  "benchmark_runner": "import json,subprocess,statistics\nfrom pathlib import Path\nresult={}\nfor case in ['small_rows','small','hundred_pages','image_table','repeated_images','mixed_styles']:\n samples={'baseline':[],'candidate':[]}\n for i in range(5):\n  for phase in (['baseline','candidate'] if i%2==0 else ['candidate','baseline']):\n   p=subprocess.run(['/tmp/docweave-wheel-test/bin/python','/tmp/docweave-post-font-worker.py',phase,case],capture_output=True,text=True,check=True)\n   sample=json.loads(p.stdout);samples[phase].append(sample)\n base=samples['baseline'][0]\n assert all(all(v[k]==base[k] for k in ['bytes','pages','records_sha256']) for group in samples.values() for v in group),case\n result[case]={'trials':samples,'medians':{phase:{k:statistics.median(v[k] for v in group) for k in ['import_ms','parse_ms','render_ms','total_ms','peak_rss_bytes']} for phase,group in samples.items()}}\n print(case,result[case]['medians'],flush=True)\nPath('/tmp/docweave-post-font-benchmark.json').write_text(json.dumps(result,indent=2)+'\\n')\n",
