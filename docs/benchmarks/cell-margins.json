  "probe": "import json,sys,runpy\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nfrom aspose.words_foss.saving import PdfSaveOptions\nassert 'site-packages' in aw.__file__,aw.__file__\nns=runpy.run_path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python/tests/test_table_cell_margins.py')\nroot=Path('/tmp/docweave-cell-margins');root.mkdir(exist_ok=True)\nbase={'left':8,'right':8,'top':6,'bottom':6}\ncases={'inherited':{'table':base},'zero-cell':{'table':base,'cell':dict.fromkeys(base,0)},\n 'four-cell':{'table':base,'cell':dict.fromkeys(base,4)},'zero-table':{'table':dict.fromkeys(base,0)},\n 'zero-style':{'styled':True,'table':{'right':0}},'implicit':{}}\nresult={}\nfor kind,kwargs in cases.items():\n source=root/(kind+'.docx')\n if not source.exists(): source.write_bytes(ns['source_docx'](**kwargs))\n for shaping in (False,True):\n  options=PdfSaveOptions();options.text_shaping=shaping\n  document=aw.Document(source);pdf_raw=document.to_bytes(options)\n  with pymupdf.open(stream=pdf_raw,filetype='pdf') as pdf:\n   words=pdf[0].get_text('words')\n   result[f'{kind}-{shaping}']={'bytes':len(pdf_raw),'pages':len(pdf),'words':[w[4] for w in words],\n    'geometry':[words[0][0],words[0][1],next(w[2] for w in words if w[4]=='LINE')]}\n   if not shaping:\n    (root/(kind+'-'+sys.argv[1]+'.pdf')).write_bytes(pdf_raw)\n    pdf[0].get_pixmap(matrix=pymupdf.Matrix(2,2)).save(root/(kind+'-'+sys.argv[1]+'.png'))\nPath('/tmp/docweave-cell-margins-'+sys.argv[1]+'.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(result)\n",
  "fixture": "tests/test_table_cell_margins.py: source_docx; source uses single line spacing and zero paragraph before/after spacing",
  "common_probe": "import hashlib,json,sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nroot=Path('/tmp/docweave-current-performance');results={}\nfor case in ('small','hundred_pages','image_table','repeated_images','mixed_styles'):\n raw=aw.Document(root/(case+'.docx')).to_bytes(aw.saving.PdfSaveOptions())\n pages=[]\n with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n  for page in pdf:\n   pages.append({key:hashlib.sha256(value).hexdigest() for key,value in {'words':repr(page.get_text('words')).encode(),'pixels':page.get_pixmap().samples,'drawings':repr(page.get_drawings()).encode(),'images':repr(page.get_image_info()).encode()}.items()})\n results[case]={'bytes':len(raw),'pages':pages}\nPath(sys.argv[1]).write_text(json.dumps(results,indent=2)+'\\n');print('five PDF corpora saved')\n",
