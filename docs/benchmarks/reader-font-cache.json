  "worker_source": "import base64, gc, hashlib, json, sys, time\nfrom io import BytesIO\nfrom pathlib import Path\nimport aspose.words_foss as aw\nresults = {}\nfor filename in sys.argv[1:]:\n    path = Path(filename)\n    raw = path.read_bytes()\n    times, hashes = [], []\n    for _ in range(5):\n        gc.collect()\n        started = time.perf_counter()\n        doc = aw.Document(BytesIO(raw))\n        model = doc.light_document_model\n        times.append((time.perf_counter() - started) * 1000)\n        hashes.append(hashlib.sha256(json.dumps(model.model_dump(by_alias=True), sort_keys=True, ensure_ascii=False, default=lambda value: {'bytes_base64':base64.b64encode(value).decode()} if isinstance(value, bytes) else str(value)).encode()).hexdigest())\n        del doc, model\n    assert len(set(hashes)) == 1, path\n    results[path.name] = {'input_sha256': hashlib.sha256(raw).hexdigest(), 'samples_ms': times, 'model_sha256': hashes[0]}\nprint(json.dumps({'module': aw.__file__, 'cases': results}))\n",
