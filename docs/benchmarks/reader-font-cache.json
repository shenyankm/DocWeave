  "style_fixture_source": "import hashlib, json, statistics, sys, time\nfrom io import BytesIO\nfrom pathlib import Path\n\npath=Path('/tmp/docweave-reader-style-probe.docx')\nif '--create' in sys.argv:\n    from docx import Document\n    from docx.enum.style import WD_STYLE_TYPE\n    from docx.shared import Pt, RGBColor\n    doc=Document()\n    paragraph=doc.styles['Normal']\n    for index in range(5):\n        style=doc.styles.add_style(f'Paragraph Level {index}', WD_STYLE_TYPE.PARAGRAPH)\n        style.base_style=paragraph\n        style.font.size=Pt(12+index)\n        style.paragraph_format.space_after=Pt(index+2)\n        paragraph=style\n    character=doc.styles['Default Paragraph Font']\n    for index in range(3):\n        style=doc.styles.add_style(f'Character Level {index}', WD_STYLE_TYPE.CHARACTER)\n        style.base_style=character\n        style.font.color.rgb=RGBColor.from_string('0055AA')\n        style.font.italic=bool(index%2)\n        character=style\n    for index in range(1000):\n        para=doc.add_paragraph(style=paragraph)\n        for j in range(4):\n            run=para.add_run(f'{index}:{j} 中文 style ')\n            run.style=character\n            if j==3:\n                run.font.size=Pt(21)\n    doc.save(path)\n    print(path)\nelse:\n    import aspose.words_foss as aw\n    raw=path.read_bytes()\n    durations=[]\n    fingerprints=[]\n    for _ in range(5):\n        started=time.perf_counter()\n        doc=aw.Document(BytesIO(raw))\n        model=doc.light_document_model\n        durations.append((time.perf_counter()-started)*1000)\n        fingerprints.append(hashlib.sha256(model.model_dump_json().encode()).hexdigest())\n    assert len(set(fingerprints))==1\n    print(json.dumps({'module':aw.__file__, 'paragraphs':1000, 'runs':4000, 'samples_ms':durations, 'median_ms':statistics.median(durations), 'model_sha256':fingerprints[0]}))\n",
