  "probe_source": "import json,runpy,sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__\nns=runpy.run_path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python/tests/test_pdf_toc_tabs.py')\nrecords={}\nfor columns in (1,2):\n for location in ('body','header','footer'):\n  for shaping in (False,True):\n   position=180 if columns==1 else 100\n   model=ns['toc_tab_model'](position,columns,location)\n   options=aw.saving.PdfSaveOptions();options.text_shaping=shaping\n   raw=ns['LdmPdfWriter'](options).write_to_bytes(model)\n   with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n    words={w[4]:w for w in pdf[0].get_text('words')}\n    key=f'{columns}-{location}-{shaping}'\n    records[key]={'expected_number_right_pt':20+position,'actual_number_right_pt':words['123'][2],'error_pt':abs(words['123'][2]-20-position),'bytes':len(raw),'pages':len(pdf),'words':words}\n    if key=='2-body-True':\n     pdf.save('/tmp/docweave-toc-tabs-'+sys.argv[1]+'.pdf')\n     pdf[0].draw_line((20+position,0),(20+position,180),color=(1,0,0),width=.3)\n     pdf[0].get_pixmap(matrix=pymupdf.Matrix(3,3)).save('/tmp/docweave-toc-tabs-'+sys.argv[1]+'.png')\nPath('/tmp/docweave-toc-tabs-'+sys.argv[1]+'.json').write_text(json.dumps(records,indent=2)+'\\n')\nprint({'cases':len(records),'max_error_pt':max(v['error_pt'] for v in records.values())})\n",
