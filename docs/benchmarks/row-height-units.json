  "fixture_generator": "import importlib.util,sys,types\nfrom pathlib import Path\nfrom io import BytesIO\nfrom docx import Document\nfrom docx.shared import Pt\nrepo=Path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python')\npackage=types.ModuleType('tests');package.__path__=[str(repo/'tests')];sys.modules['tests']=package\nspec=importlib.util.spec_from_file_location('tests.test_table_direction',repo/'tests/test_table_direction.py');module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\ndoc=Document(BytesIO(module.source_docx(bidi=False)));table=doc.tables[0]\nfor i in range(120):\n row=table.rows[0] if i==0 else table.add_row()\n for j,cell in enumerate(row.cells):\n  cell.text=('A' if j==0 else 'B')+str(i).zfill(3)\n  paragraph=cell.paragraphs[0];paragraph.paragraph_format.line_spacing=1\n  paragraph.paragraph_format.space_before=paragraph.paragraph_format.space_after=Pt(0)\n  paragraph.runs[0].font.size=Pt(8)\nroot=Path(sys.argv[1]);root.mkdir(exist_ok=True);doc.save(root/'small-rows.docx')\nassert len(doc.tables[0].rows)==120\n",
  "worker": "import hashlib,json,resource,sys,time\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nsource=Path('/tmp/docweave-row-height-units/small-rows.docx')\ndoc=aw.Document(source);start=time.perf_counter();raw=doc.to_bytes(aw.saving.PdfSaveOptions());elapsed=time.perf_counter()-start\nwith pymupdf.open(stream=raw,filetype='pdf') as pdf:\n words=[w[4] for p in pdf for w in p.get_text('words')]\n assert sorted(words)==sorted(prefix+str(i).zfill(3) for prefix in ['A','B'] for i in range(120))\n record={'seconds':elapsed,'peak_rss_bytes':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'pages':len(pdf),'bytes':len(raw),'words_sha256':hashlib.sha256(json.dumps(sorted(words)).encode()).hexdigest()}\nPath('/tmp/docweave-row-height-units/small-rows-'+sys.argv[1]+'.pdf').write_bytes(raw)\nprint(json.dumps(record))\n",
  "word_probe": "import json,sys,hashlib\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nroot=Path('/tmp/docweave-table-direction');result={}\nfor name in ['word-proof','word-border-proof','word-legacy-12']:\n source=root/(name+'.docx');raw=aw.Document(source).to_bytes(aw.saving.PdfSaveOptions());(root/(name+'-row-height.pdf')).write_bytes(raw)\n case={'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest()}\n for label,path in [('native',root/(name+'.pdf')),('before',root/(name+'-final.pdf')),('after',root/(name+'-row-height.pdf'))]:\n  with pymupdf.open(path) as pdf:\n   pages=[]\n   for p in pdf:\n    lines=[d['rect'] for d in p.get_drawings() if d['rect'].width>d['rect'].height]\n    y=sorted(set((r.y0+r.y1)/2 for r in lines))\n    pages.append({'word_x':{w[4]:w[0] for w in p.get_text('words')},'horizontal_border_centers_y':y,'row_height_pt':y[-1]-y[0] if y else None})\n   case[label]={'pages':len(pdf),'geometry':pages}\n result[name]=case\nPath('/tmp/docweave-row-height-word.json').write_text(json.dumps(result,indent=2)+'\\n');print(result['word-proof'])\n",
  "common_probe": "import hashlib,json,sys\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__,aw.__file__\nroot=Path('/tmp/docweave-current-performance');results={}\nfor case in ('small','hundred_pages','image_table','repeated_images','mixed_styles'):\n raw=aw.Document(root/(case+'.docx')).to_bytes(aw.saving.PdfSaveOptions())\n pages=[]\n with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n  for page in pdf:\n   pages.append({key:hashlib.sha256(value).hexdigest() for key,value in {'words':repr(page.get_text('words')).encode(),'pixels':page.get_pixmap().samples,'drawings':repr(page.get_drawings()).encode(),'images':repr(page.get_image_info()).encode()}.items()})\n results[case]={'bytes':len(raw),'pages':pages}\nPath(sys.argv[1]).write_text(json.dumps(results,indent=2)+'\\n');print('five PDF corpora saved')\n",
