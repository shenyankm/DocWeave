  "probe_source": "import json, sys, runpy\nfrom pathlib import Path\nimport pymupdf\nimport aspose.words_foss as aw\nassert 'site-packages' in aw.__file__, aw.__file__\nroot = Path('/Users/sheny/Developer/code/Aspose.Words-FOSS-for-Python')\nns = runpy.run_path(str(root / 'tests/test_pdf_justification.py'))\nsource = (root / 'tests/test_pdf_cell_justification.py').read_text().split('@pytest.mark.parametrize', 1)[0]\nexec(source.replace('from .test_pdf_justification import WORDS, lines', ''), ns)\nresult = {}\nfor shaping in (False, True):\n for kind in ('plain','mixed','merged','list','first','hanging','manual','manual-disabled','nowrap-manual'):\n  model, paragraph = ns['cell_model'](mixed=kind=='mixed', merged=kind=='merged', listed=kind=='list',\n    text='SHORT LINE\\nLAST' if 'manual' in kind else ns['WORDS'], disabled=kind=='manual-disabled', wrap=kind!='nowrap-manual')\n  if kind in ('first','hanging'):\n   paragraph.paragraph_format.left_indent=24\n   paragraph.paragraph_format.right_indent=6\n   paragraph.paragraph_format.first_line_indent=12 if kind=='first' else -12\n  raw=ns['render'](model, shaping)\n  key=f'{kind}-{shaping}'\n  with pymupdf.open(stream=raw,filetype='pdf') as pdf:\n   rows=ns['lines'](pdf[0])\n   result[key]={'bytes':len(raw),'pages':len(pdf),'bounds':[list(row['bbox']) for row in rows],\n    'words':[word[4] for page in pdf for word in page.get_text('words')]}\n   if kind=='mixed' and not shaping:\n    pdf[0].get_pixmap(matrix=pymupdf.Matrix(3,3)).save('/tmp/docweave-cell-justification-'+sys.argv[1]+'.png')\n   Path('/tmp/docweave-cell-'+key+'-'+sys.argv[1]+'.pdf').write_bytes(raw)\nPath('/tmp/docweave-cell-justification-'+sys.argv[1]+'.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint({key: {'rows':len(value['bounds']), 'bounds':value['bounds'][:2]} for key,value in result.items()})\n",
  "native_probe_source": "from pathlib import Path\nfrom docx import Document\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.shared import Pt\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\nimport aspose.words_foss as aw\nfrom aspose.words_foss.saving import PdfSaveOptions\nroot=Path('/tmp/docweave-cell-native'); root.mkdir(exist_ok=True)\nfor disabled in (False,True):\n d=Document(); s=d.sections[0]\n s.page_width=Pt(300); s.page_height=Pt(300)\n s.left_margin=s.right_margin=s.top_margin=s.bottom_margin=Pt(20)\n t=d.add_table(rows=1,cols=1);t.autofit=False;t.columns[0].width=Pt(260)\n t.style='Table Grid'\n c=t.cell(0,0);m=OxmlElement('w:tcMar')\n for n in ('left','right'):\n  e=OxmlElement('w:'+n);e.set(qn('w:w'),'160');e.set(qn('w:type'),'dxa');m.append(e)\n c._tc.get_or_add_tcPr().append(m)\n for text in ('ONE TWO THREE FOUR FIVE SIX SEVEN EIGHT NINE TEN ELEVEN TWELVE','SHORT LINE\\nLAST'):\n  p=c.paragraphs[0] if not c.paragraphs[0].text else c.add_paragraph()\n  p.alignment=WD_ALIGN_PARAGRAPH.JUSTIFY\n  p.paragraph_format.left_indent=Pt(24);p.paragraph_format.right_indent=Pt(6);p.paragraph_format.first_line_indent=Pt(12)\n  r=p.add_run(text);r.font.name='Arial';r.font.size=Pt(12)\n if disabled:\n  compat=d.settings.element.find(qn('w:compat'))\n  if compat is None: compat=OxmlElement('w:compat');d.settings.element.append(compat)\n  compat.append(OxmlElement('w:doNotExpandShiftReturn'))\n source=root/f'cell-{disabled}.docx';d.save(source)\n aw.Document(source).save(root/f'cell-{disabled}-library.pdf',PdfSaveOptions())\nprint(root)\n",
